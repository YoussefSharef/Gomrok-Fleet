# Postgres connection string. On Vercel, add "Postgres" storage to the
# project and copy the connection string it gives you here (any of the
# variants it shows work for this app's scale). Locally, either point this
# at the same cloud database, or run Postgres yourself, e.g.:
#   docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gomrok_fleet"
DATABASE_URL=

JWT_SECRET="change-me-in-production"
PORT=4000
# Comma-separated list of allowed client origins in production, e.g.
# CORS_ORIGIN="https://your-app.vercel.app"
# Leave unset for local dev (allows all origins).
CORS_ORIGIN=
